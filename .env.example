# =============================================================================
# ENVIRONMENT VARIABLES FOR USER SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
USER_SERVICE_PORT=8001

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-still-glade-b36k57z5-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=user_db;Username=neondb_owner;Password=<REPLACE_WITH_USER_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
USER_CONNECTION_STRING=Host=ep-still-glade-b36k57z5-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=user_db;Username=neondb_owner;Password=<REPLACE_WITH_USER_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Redis Cache (Docker network: redis:6379; Local host: localhost:6379)
REDIS_CONNECTION_STRING=redis:6379

# RabbitMQ (Docker network: rabbitmq; Local host: localhost)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# JWT Authentication Settings
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=<REPLACE_WITH_JWT_SIGNING_KEY_MIN_32_CHARS>
JWT_EXPIRATION_IN_MINUTES=60
