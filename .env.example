# =============================================================================
# ENVIRONMENT VARIABLES FOR USER SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
USER_SERVICE_PORT=8001

# Database Connection (Local PostgreSQL - Port 5433)
CONNECTION_STRING=Host=localhost;Port=5433;Database=usermanagement_db;Username=postgres;Password=postgres
USER_CONNECTION_STRING=Host=localhost;Port=5433;Database=usermanagement_db;Username=postgres;Password=postgres
USER_DB_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Cache (Docker network: redis:6379; Local host: localhost:6379 - Shared 500MB)
REDIS_CONNECTION_STRING=localhost:6379

# RabbitMQ (Docker network: rabbitmq; Local host: localhost)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# JWT Authentication Settings
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=$d)aam<_ze0E0bGB/5b7YE|^(sxQF_V(,dZusL*?$G{aqgXd&$M#+wd(R+<JN%eZ
JWT_EXPIRATION_IN_MINUTES=60
