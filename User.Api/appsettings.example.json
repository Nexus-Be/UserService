{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=usermanagement_db;Username=postgres;Password=<REPLACE_WITH_DB_PASSWORD>"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": "5672",
    "User": "guest",
    "Password": "<REPLACE_WITH_RABBITMQ_PASSWORD>"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Otel": {
    "Endpoint": "http://localhost:4317"
  },
  "Jwt": {
    "Issuer": "http://localhost:8001",
    "Audience": "shoppingcart-api",
    "Signature": "<REPLACE_WITH_JWT_SECRET>",
    "ExpirationInMinutes": 60
  }
}
