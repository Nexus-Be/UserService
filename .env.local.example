# =============================================================================
# NEXUS USER SERVICE - ENVIRONMENT (.env.local.example)
# =============================================================================
# DB local (cụm src/Infrastructure/databases). Hạ tầng dùng chung nexus-network.

ASPNETCORE_ENVIRONMENT=Development
USER_SERVICE_PORT=8001

# Database (Neon Cloud PostgreSQL)
USER_DB_CONNECTION=Host=localhost;Port=5433;Database=usermanagement_db;Username=postgres;Password=postgres

# Redis (shared instance)
REDIS_CONNECTION_STRING=localhost:6379

# JWT signing
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e
JWT_EXPIRATION_IN_MINUTES=60

# Downstream service URLs
NOTIFICATION_SERVICE_URL=http://localhost:8007

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
