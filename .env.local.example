# =============================================================================
# USER SERVICE - LOCAL ENVIRONMENT CONFIGURATION (.env.local.example)
# =============================================================================
# Áp dụng: cp .env.local.example .env
ASPNETCORE_ENVIRONMENT=Development
USER_SERVICE_PORT=8001

# Database Connection (Local Docker PostgreSQL: Port 5433)
CONNECTION_STRING=Host=localhost;Port=5433;Database=usermanagement_db;Username=postgres;Password=postgres
USER_CONNECTION_STRING=Host=localhost;Port=5433;Database=usermanagement_db;Username=postgres;Password=postgres
USER_DB_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Cache
REDIS_CONNECTION_STRING=localhost:6379

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# JWT Authentication Settings
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=your_jwt_super_secret_key_minimum_32_characters_here!
JWT_EXPIRATION_IN_MINUTES=60

# Notification Service REST Client Base URL
Services__Notification__BaseUrl=http://localhost:8007/
