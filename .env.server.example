# =============================================================================
# USER SERVICE - SERVER ENVIRONMENT CONFIGURATION (.env.server.example)
# =============================================================================
# Áp dụng: cp .env.server.example .env
ASPNETCORE_ENVIRONMENT=Development
USER_SERVICE_PORT=8001

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=postgresql://neondb_owner:npg_DFRbf6AWI8XO@ep-fancy-poetry-a1frv94q-pooler.ap-southeast-1.aws.neon.tech/user?sslmode=require&channel_binding=require
USER_CONNECTION_STRING=postgresql://neondb_owner:npg_DFRbf6AWI8XO@ep-fancy-poetry-a1frv94q-pooler.ap-southeast-1.aws.neon.tech/user?sslmode=require&channel_binding=require

# Redis Cache (Docker network: redis:6379)
REDIS_CONNECTION_STRING=redis:6379

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# JWT Authentication Settings
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=<REPLACE_WITH_JWT_SIGNING_KEY_MIN_32_CHARS>
JWT_EXPIRATION_IN_MINUTES=60

# Notification Service REST Client Base URL
Services__Notification__BaseUrl=http://notification-service:8007/
